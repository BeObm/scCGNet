Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

%post
    apt-get update
    apt-get install -y \
        python3 \
        python3-pip \
        python3-dev \
        build-essential \
        git \
        wget \
        curl

    python3 -m pip install --upgrade pip

    pip install \
        numpy \
        pandas \
        scipy \
        scikit-learn \
        matplotlib \
        tqdm \
        scanpy \
        anndata \
        h5py\
        pyreadr\
        networkx\
        seaborn

    pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124
    pip install torch-geometric
    pip install keras
    pip install tensorflow
    pip install munkres
    pip install copulae

%environment
    export LC_ALL=C
    export PYTHONNOUSERSITE=1

%runscript
    python3 "$@"

